#!/bin/bash
# ============================================================
#  旧ターミナル版（使用停止）
#
#  このファイルは以前、セットアップ処理を自前で持つ独立実装だったが、
#  setup_common.sh に入っている Intel Mac 対策（llvmlite/numba のwheel固定、
#  jaxlib除外、mediapipeバージョン固定、Python3.12優先）が一切入っておらず、
#  こちらを起動した人だけ別系統の古い環境が構築されてしまう問題があった。
#  修正も二重管理になるため、新しい起動ファイルへ案内する形に差し替えた。
# ============================================================
cd "$(dirname "$0")"
clear
echo "========================================================"
echo "  こちらは旧版です"
echo "========================================================"
echo ""
echo "  「これをダブルクリック！.command」を使ってください。"
echo "  （ブラウザ画面で同じことが、より安定してできます）"
echo ""
open "$(dirname "$0")" 2>/dev/null
read -p "Enterで閉じる..."
